# ============================================================================
# rustsearch — generated locally, never committed, never shown on GitHub
#
# Rule of thumb: everything here is reproducible from `cargo build`,
# `rustsearch build|shard`, `wasm-bindgen` or a CI run. If a file is an input
# to a test (fixtures/, adapters/ui/tests/fixtures/) it is NOT listed.
# ============================================================================

# ---------------------------------------------------------------------------
# Rust / Cargo build output
# ---------------------------------------------------------------------------
/target/
**/target/
/fuzz/artifacts/
/fuzz/corpus/

# ---------------------------------------------------------------------------
# wasm-bindgen output (regenerated by the build, never an input)
# ---------------------------------------------------------------------------
/wasm/pkg-web/
/wasm/pkg-node/
/adapters/cloudflare/pkg/
/adapters/ui/pkg-web/
/adapters/ui/pkg-node/
/adapters/ui/vendor/pkg-web/

# ---------------------------------------------------------------------------
# Built indexes and published shard sets
# (fixtures/site and adapters/ui/tests/fixtures stay tracked: they are inputs)
# ---------------------------------------------------------------------------
/dist/
/adapters/cloudflare/dist/
/adapters/ui/demo/
/adapters/ui/shards/
/*.rsx
/*.rsx.sha256
*.sha256

# ---------------------------------------------------------------------------
# Supply-chain output
# ---------------------------------------------------------------------------
/sbom/
*.cdx.json

# ---------------------------------------------------------------------------
# Node / adapter tooling
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Coverage and profiling
# ---------------------------------------------------------------------------
coverage/
lcov.info
*.profraw
*.profdata

# ---------------------------------------------------------------------------
# Local Cloudflare config and secrets
# wrangler.toml.example is the template and stays versioned; the copy is local.
# ---------------------------------------------------------------------------
/adapters/cloudflare/.wrangler/
/adapters/cloudflare/.dev.vars
/adapters/cloudflare/wrangler.toml
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Logs and scratch files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak

# ---------------------------------------------------------------------------
# IDE / editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Private review notes: kept on disk, never committed.
/SKILLS.md
/PRODUCT_REVIEW.md
/ROADMAP.md

# Private measurement log: kept on disk, never committed.
/OPTIMIZATIONS.md
